# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Only the data commands read these keys; tests and `momenta verify` do not.

# Sharadar Core US Equities Bundle with full history: https://sharadar.com/
SHARADAR_API_KEY=

# FRED API key for VIXCLS, BAA10Y, T10Y3M and USREC: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
